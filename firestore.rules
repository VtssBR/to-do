rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de validação
    function isValidStatus(status) {
      return status in ['todo', 'in-progress', 'done'];
    }

    function isValidPriority(priority) {
      return priority in ['alta', 'media', 'baixa'];
    }

    function isValidCategory(category) {
      return category in ['Trabalho', 'Produto', 'Pessoal', 'Estudos'];
    }

    function hasValidFields(data) {
      return data.title is string 
        && data.title.size() > 0 
        && data.title.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('dueDate' in data) || data.dueDate is string)
        && isValidStatus(data.status)
        && isValidPriority(data.priority)
        && isValidCategory(data.category)
        && data.order is number;
    }

    function isAuthenticatedAndVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /tasks/{taskId} {
      // Exige usuário autenticado e com e-mail verificado para operações
      allow read: if isAuthenticatedAndVerified();

      // Criação: exige validação estrita dos campos e timestamps válidos
      allow create: if isAuthenticatedAndVerified()
                    && hasValidFields(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      // Atualização: não permite alterar createdAt nem id, valida campos
      allow update: if isAuthenticatedAndVerified()
                    && hasValidFields(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;

      // Exclusão permitida para usuários autenticados e verificados
      allow delete: if isAuthenticatedAndVerified();
    }
  }
}
